+#[test_case::test_case(ThreadHistoryMode::Paginated, MultiAgentVersion::V1, false; "paginated_v1")]
+#[test_case::test_case(ThreadHistoryMode::Legacy, MultiAgentVersion::V2, false; "legacy_v2_filtered")]
+#[test_case::test_case(ThreadHistoryMode::Paginated, MultiAgentVersion::V2, false; "paginated_v2_filtered")]
+#[test_case::test_case(ThreadHistoryMode::Legacy, MultiAgentVersion::V2, true; "legacy_v2_preserved")]
+#[test_case::test_case(ThreadHistoryMode::Paginated, MultiAgentVersion::V2, true; "paginated_v2_preserved")]
+#[tokio::test]
+async fn steward_cas_cold_resume_preserves_constructed_model_input(
+    history_mode: ThreadHistoryMode,
+    version: MultiAgentVersion,
+    preserve_fork_prefix: bool,
+) {
+    let mut harness = AgentControlHarness::new().await;
+    if version == MultiAgentVersion::V2 {
+        harness
+            .config
+            .features
+            .enable(Feature::MultiAgentV2)
+            .unwrap();
+    } else {
+        harness
+            .config
+            .features
+            .disable(Feature::MultiAgentV2)
+            .unwrap();
+    }
+    harness.config.developer_instructions = Some("Parent developer context.".to_string());
+    let parent = harness
+        .manager
+        .start_thread(StartThreadOptions {
+            history_mode: Some(history_mode),
+            environments: Some(Vec::new()),
+            ..StartThreadOptions::new(harness.config.clone())
+        })
+        .await
+        .expect("start real parent");
+    let parent_id = parent.thread_id;
+    let turn = parent.thread.session.new_default_turn().await;
+    let spawn_call_id = "steward-cas-cold-spawn".to_string();
+    let mut developer = user_message("Parent developer context.");
+    if let ResponseItem::Message { role, .. } = &mut developer {
+        *role = "developer".to_string();
+    }
+    parent
+        .thread
+        .session
+        .persist_rollout_items(&[
+            RolloutItem::Compacted(Box::new(CompactedItem {
+                message: String::new(),
+                replacement_history: Some(vec![
+                    user_message("Root authorization A: inspect the supplied source.").into(),
+                    developer.into(),
+                    assistant_message("Parent final answer.", Some(MessagePhase::FinalAnswer))
+                        .into(),
+                    user_message("Root authorization B: retain every original byte.").into(),
+                ]),
+                retained_context: Some(codex_history::RetainedContext::default()),
+                guardian_history: Some(codex_history::GuardianHistoryCheckpoint(vec![
+                    user_message("PARENT_PRIVATE_APPROVAL_MUST_NOT_REAPPEAR").into(),
+                ])),
+                mcp_resource_origins: None,
+                window_number: Some(1),
+                first_window_id: None,
+                previous_window_id: None,
+                window_id: None,
+                compaction_response_id: None,
+                latest_token_usage_record: None,
+                resume_metadata: Some(codex_history::CompactionResumeMetadata {
+                    rejected_audio_file_ids: Default::default(),
+                    dynamic_tools: None,
+                    multi_agent_version: Some(version),
+                    last_started_turn_id: None,
+                    turn_attribution: None,
+                    previous_turn_settings: None,
+                }),
+            })),
+            RolloutItem::TurnContext(turn.to_turn_context_item()),
+            rollout_response_item(spawn_agent_call(&spawn_call_id)),
+        ])
+        .await;
+    parent.thread.ensure_rollout_materialized().await;
+    parent
+        .thread
+        .flush_rollout()
+        .await
+        .expect("flush compacted parent");
+    let mut child_config = harness.config.clone();
+    child_config.multi_agent_v2.preserve_fork_prefix = preserve_fork_prefix;
+    child_config.developer_instructions = Some("Child developer context.".to_string());
+    child_config.multi_agent_v2.subagent_developer_instructions =
+        Some("Child developer context.".to_string());
+    let child_source = SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+        parent_thread_id: parent_id,
+        depth: 1,
+        agent_path: None,
+        agent_nickname: None,
+        agent_role: None,
+    });
+    let child_id = harness
+        .control
+        .spawn_agent_with_metadata(
+            child_config.clone(),
+            text_input("child task"),
+            child_source.clone(),
+            SpawnAgentOptions {
+                parent_thread_id: Some(parent_id),
+                fork_parent_spawn_call_id: Some(spawn_call_id),
+                fork_mode: Some(SpawnAgentForkMode::FullHistory),
+                ..Default::default()
+            },
+        )
+        .await
+        .expect("spawn real full-history child")
+        .thread_id;
+    let child = harness
+        .manager
+        .get_thread(child_id)
+        .await
+        .expect("live child");
+    persist_thread_for_tree_resume(&child, "child durable local task").await;
+    let path = child.rollout_path().expect("durable child path");
+    let cas_enabled = std::env::var_os("CODEX_STEWARD_CAS").is_some_and(|value| value == "1");
+    assert_eq!(
+        codex_rollout::is_steward_cas_rollout(&path).expect("storage marker"),
+        cas_enabled,
+        "the real child must select CAS exactly when the opt-in is enabled"
+    );
+    let live_history = child.session.clone_history().await;
+    let expected_history = live_history.annotated_items().to_vec();
+    let expected_authorization =
+        serde_json::to_value(live_history.retained_context()).expect("live authorization");
+    let expected_guardian = serde_json::to_value(live_history.guardian_history_checkpoint())
+        .expect("live guardian context");
+    assert!(
+        !history_contains_text(
+            live_history.conversation_history_snapshot().review_items(),
+            "PARENT_PRIVATE_APPROVAL_MUST_NOT_REAPPEAR"
+        ),
+        "fork must sanitize parent-local review evidence"
+    );
+    let request = constructed_response_request(&child).await;
+    let expected_input = serde_json::to_vec(&request.input).expect("live constructed input bytes");
+    let first = request
+        .input
+        .iter()
+        .position(|item| history_contains_text([item], "Root authorization A:"))
+        .expect("first inherited user instruction");
+    let second = request
+        .input
+        .iter()
+        .position(|item| history_contains_text([item], "Root authorization B:"))
+        .expect("second inherited user instruction");
+    assert!(
+        first < second,
+        "inherited user instructions must retain their original order"
+    );
+    assert!(!history_contains_text(
+        request.input.iter(),
+        "PARENT_PRIVATE_APPROVAL_MUST_NOT_REAPPEAR"
+    ));
+    drop(live_history);
+    harness
+        .control
+        .shutdown_live_agent(child_id)
+        .await
+        .expect("shutdown and unload child");
+    assert!(harness.manager.get_thread(child_id).await.is_err());
+    drop(child);
+    let resumed_id = harness
+        .control
+        .resume_agent_from_rollout(child_config, child_id, child_source)
+        .await
+        .expect("cold resume child from its persisted CAS path");
+    assert_eq!(resumed_id, child_id);
+    let resumed = harness
+        .manager
+        .get_thread(child_id)
+        .await
+        .expect("cold resumed child");
+    assert_eq!(resumed.rollout_path().as_ref(), Some(&path));
+    let resumed_history = resumed.session.clone_history().await;
+    assert!(
+        resumed_history.annotated_items() == expected_history.as_slice(),
+        "cold resume must preserve exact model items, roles, IDs and inherited metadata"
+    );
+    assert_eq!(
+        serde_json::to_value(resumed_history.retained_context()).expect("resumed authorization"),
+        expected_authorization
+    );
+    assert_eq!(
+        serde_json::to_value(resumed_history.guardian_history_checkpoint())
+            .expect("resumed guardian context"),
+        expected_guardian
+    );
+    let resumed_request = constructed_response_request(&resumed).await;
+    assert!(
+        serde_json::to_vec(&resumed_request.input).expect("resumed constructed input bytes")
+            == expected_input,
+        "live and cold-resumed child must construct exactly the same serialized model input"
+    );
+    harness
+        .control
+        .shutdown_live_agent(child_id)
+        .await
+        .expect("shutdown resumed child");
+    parent
+        .thread
+        .shutdown_and_wait()
+        .await
+        .expect("shutdown parent");
+}
+
 #[test_case::test_case(false; "complete")]
 #[test_case::test_case(true; "error_reason")]
