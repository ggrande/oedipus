+//! Experimental exact-byte storage for a subagent's inherited context.
+//!
+//! Model context is transformed by the existing agent code before this boundary. We store
+//! opaque serialized bytes, never interpret or summarize role or authorization content.
+//! The physical first record deliberately is not a SessionMeta: an unpatched reader must
+//! not mistake the child's local tail for its complete history.
+
+use std::fs::File;
+use std::io;
+use std::io::BufRead;
+use std::io::BufReader;
+use std::io::Read;
+use std::io::Seek;
+use std::io::SeekFrom;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+
+use serde::Deserialize;
+use serde::Serialize;
+use sha2::Digest;
+use sha2::Sha256;
+
+const MARKER: &[u8] = b"{\"steward_cas_v1\":";
+const MAX_HEADER_BYTES: u64 = 16 * 1024 * 1024;
+const MAX_MANIFEST_BYTES: u64 = 128 * 1024 * 1024;
+const MAX_BLOB_LOGICAL_BYTES: u64 = 512 * 1024 * 1024;
+
+#[derive(Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct HeaderEnvelope {
+    steward_cas_v1: Header,
+}
+
+#[derive(Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct Header {
+    logical_session_meta: String,
+    prefix_end_ordinal: u64,
+}
+
+#[derive(Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct Record {
+    ordinal: u64,
+    literal: String,
+    sha256: String,
+    bytes: u64,
+    #[serde(default)]
+    codec: BlobCodec,
+    #[serde(default)]
+    stored_bytes: Option<u64>,
+}
+
+#[derive(Clone, Copy, Default, Deserialize, Serialize)]
+#[serde(rename_all = "snake_case")]
+enum BlobCodec {
+    #[default]
+    Raw,
+    Zstd,
+}
+
+fn invalid(message: &str) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, message)
+}
+
+fn digest(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+
+fn paths(path: &Path) -> io::Result<(PathBuf, PathBuf)> {
+    let name = path
+        .file_name()
+        .ok_or_else(|| invalid("CAS rollout has no filename"))?;
+    let home = path
+        .ancestors()
+        .find_map(|ancestor| {
+            matches!(
+                ancestor.file_name().and_then(|name| name.to_str()),
+                Some("sessions" | "archived_sessions")
+            )
+            .then(|| ancestor.parent())
+            .flatten()
+        })
+        .ok_or_else(|| invalid("CAS rollout is outside a Codex sessions directory"))?;
+    let root = home.join("steward-cas-v1");
+    let manifest = root
+        .join("prefixes")
+        .join(name)
+        .with_extension("jsonl.prefix");
+    Ok((root.join("blobs"), manifest))
+}
+
+fn header(file: &mut File) -> io::Result<Option<(Header, u64)>> {
+    file.rewind()?;
+    let mut marker = [0; MARKER.len()];
+    let count = file.read(&mut marker)?;
+    file.rewind()?;
+    if count != marker.len() || marker != MARKER {
+        return Ok(None);
+    }
+    let mut line = String::new();
+    BufReader::new(file.take(MAX_HEADER_BYTES)).read_line(&mut line)?;
+    if !line.ends_with('\n') {
+        return Err(invalid("CAS rollout header is incomplete or oversized"));
+    }
+    let envelope: HeaderEnvelope = serde_json::from_str(&line)?;
+    let header = envelope.steward_cas_v1;
+    if header.prefix_end_ordinal < 2 || !header.logical_session_meta.ends_with('\n') {
+        return Err(invalid("invalid CAS rollout header"));
+    }
+    Ok(Some((header, line.len() as u64)))
+}
+
+/// Whether a rollout requires the Steward reader. Errors must not be treated as plain history.
+pub fn is_steward_cas_rollout(path: &Path) -> io::Result<bool> {
+    Ok(header(&mut File::open(path)?)?.is_some())
+}
+
+pub(crate) fn enabled() -> bool {
+    std::env::var_os("CODEX_STEWARD_CAS").is_some_and(|value| value == "1")
+}
+
+pub(crate) fn wrap_session_meta(json: &str, prefix_end_ordinal: u64) -> io::Result<String> {
+    let mut wrapped = serde_json::to_string(&HeaderEnvelope {
+        steward_cas_v1: Header {
+            logical_session_meta: json.to_owned(),
+            prefix_end_ordinal,
+        },
+    })?;
+    wrapped.push('\n');
+    Ok(wrapped)
+}
+
+/// A flush/sync acknowledgement can fail after the complete header was written. Retrying
+/// preserves that first header and timestamp instead of appending another physical header.
+pub(crate) fn header_already_published(
+    path: &Path,
+    logical_session_meta: &str,
+    prefix_end_ordinal: u64,
+) -> io::Result<bool> {
+    let mut file = File::options().read(true).write(true).open(path)?;
+    if file.metadata()?.len() == 0 {
+        return Ok(false);
+    }
+    let (existing, physical_end) =
+        header(&mut file)?.ok_or_else(|| invalid("new CAS storage requires an empty rollout"))?;
+    fn item_suffix(line: &str) -> &str {
+        line.find(",\"type\":")
+            .map(|split| &line[split..])
+            .unwrap_or(line)
+    }
+    if existing.prefix_end_ordinal != prefix_end_ordinal
+        || item_suffix(&existing.logical_session_meta) != item_suffix(logical_session_meta)
+        || file.metadata()?.len() != physical_end
+    {
+        return Err(invalid(
+            "CAS metadata retry does not match its original header",
+        ));
+    }
+    file.sync_all()?;
+    Ok(true)
+}
+
+pub(crate) fn prefix_end(path: &Path) -> io::Result<Option<u64>> {
+    Ok(header(&mut File::open(path)?)?.map(|(header, _)| header.prefix_end_ordinal))
+}
+
+fn read_records(manifest: &Path) -> io::Result<Vec<Record>> {
+    let file = File::open(manifest)?;
+    if file.metadata()?.len() > MAX_MANIFEST_BYTES {
+        return Err(invalid("CAS prefix manifest is oversized"));
+    }
+    let mut records = Vec::new();
+    for line in BufReader::new(file).split(b'\n') {
+        let line = line?;
+        if line.is_empty() {
+            continue;
+        }
+        let record: Record = serde_json::from_slice(&line)?;
+        if record.ordinal != records.len() as u64 + 1
+            || record.sha256.len() != 64
+            || !record
+                .sha256
+                .bytes()
+                .all(|byte| byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase())
+        {
+            return Err(invalid("CAS prefix manifest has invalid ordinal or hash"));
+        }
+        records.push(record);
+    }
+    // A missing final newline is an interrupted publication, never valid EOF.
+    let mut file = File::open(manifest)?;
+    if file.metadata()?.len() != 0 {
+        file.seek(SeekFrom::End(-1))?;
+        let mut last = [0];
+        file.read_exact(&mut last)?;
+        if last != [b'\n'] {
+            return Err(invalid("CAS prefix manifest has a partial final record"));
+        }
+    }
+    Ok(records)
+}
+
+fn sync_directory(path: &Path) -> io::Result<()> {
+    #[cfg(unix)]
+    File::open(path)?.sync_all()?;
+    // Windows directory handles require platform-specific opening flags. Blob and manifest
+    // files are synced there; power-loss directory durability remains an explicit release gate.
+    #[cfg(not(unix))]
+    let _ = path;
+    Ok(())
+}
+
+fn blob_path(root: &Path, record: &Record) -> PathBuf {
+    match record.codec {
+        BlobCodec::Raw => root.join(&record.sha256),
+        BlobCodec::Zstd => root.join(format!("{}.zst", record.sha256)),
+    }
+}
+
+fn read_blob(root: &Path, record: &Record) -> io::Result<Vec<u8>> {
+    if record.bytes > MAX_BLOB_LOGICAL_BYTES {
+        return Err(invalid("CAS blob exceeds its bounded logical size"));
+    }
+    let file = File::open(blob_path(root, record))?;
+    let stored_bytes = file.metadata()?.len();
+    if record
+        .stored_bytes
+        .is_some_and(|expected| expected != stored_bytes)
+        || stored_bytes > MAX_BLOB_LOGICAL_BYTES + 1024 * 1024
+    {
+        return Err(invalid(
+            "CAS blob stored length does not match its manifest",
+        ));
+    }
+    let reader: Box<dyn Read> = match record.codec {
+        BlobCodec::Raw => Box::new(file),
+        BlobCodec::Zstd => Box::new(zstd::stream::read::Decoder::new(file)?),
+    };
+    let mut bytes = Vec::new();
+    reader.take(record.bytes + 1).read_to_end(&mut bytes)?;
+    if bytes.len() as u64 != record.bytes || digest(&bytes) != record.sha256 {
+        return Err(invalid(
+            "CAS inherited blob is truncated, oversized or corrupt",
+        ));
+    }
+    Ok(bytes)
+}
+
+fn publish_blob(root: &Path, record: &Record, bytes: &[u8]) -> io::Result<u64> {
+    if bytes.len() as u64 > MAX_BLOB_LOGICAL_BYTES {
+        return Err(invalid("CAS blob exceeds its bounded logical size"));
+    }
+    std::fs::create_dir_all(root)?;
+    let path = blob_path(root, record);
+    if path.exists() {
+        if read_blob(root, record)? != bytes {
+            return Err(invalid("CAS payload identity collision"));
+        }
+        return Ok(std::fs::metadata(path)?.len());
+    }
+    let mut temporary = tempfile::NamedTempFile::new_in(root)?;
+    let compressed = zstd::stream::encode_all(bytes, 3)?;
+    temporary.write_all(&compressed)?;
+    temporary.as_file().sync_all()?;
+    match temporary.persist_noclobber(&path) {
+        Ok(_) => {}
+        Err(error) if error.error.kind() == io::ErrorKind::AlreadyExists => {
+            if read_blob(root, record)? != bytes {
+                return Err(invalid("CAS concurrent payload identity collision"));
+            }
+        }
+        Err(error) => return Err(error.error),
+    }
+    sync_directory(root)?;
+    Ok(std::fs::metadata(path)?.len())
+}
+
+/// Commits a transformed inherited record before the recorder acknowledges its append.
+pub(crate) fn append_prefix(path: &Path, ordinal: u64, json: &str) -> io::Result<()> {
+    let (head, _) = header(&mut File::open(path)?)?
+        .ok_or_else(|| invalid("CAS prefix write requires its durable rollout header"))?;
+    if ordinal == 0 || ordinal >= head.prefix_end_ordinal {
+        return Err(invalid(
+            "CAS prefix append is outside the inherited boundary",
+        ));
+    }
+    // Timestamp and ordinal are unique to this rollout. The opaque item suffix can be shared
+    // after the stock child transform, including all role and authorization bytes.
+    let split = json.find(",\"type\":").unwrap_or(0);
+    let (literal, shared) = json.split_at(split);
+    let mut record = Record {
+        ordinal,
+        literal: literal.to_owned(),
+        sha256: digest(shared.as_bytes()),
+        bytes: shared.len() as u64,
+        codec: BlobCodec::Zstd,
+        stored_bytes: None,
+    };
+    let (blobs, manifest) = paths(path)?;
+    let directory = manifest
+        .parent()
+        .ok_or_else(|| invalid("CAS manifest has no parent"))?;
+    std::fs::create_dir_all(directory)?;
+    let records = match read_records(&manifest) {
+        Ok(records) => records,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Vec::new(),
+        Err(error) => return Err(error),
+    };
+    if let Some(previous) = records.get((ordinal - 1) as usize) {
+        if previous.sha256 != record.sha256 || previous.bytes != record.bytes {
+            return Err(invalid("CAS prefix retry changed inherited content"));
+        }
+        read_blob(&blobs, previous)?;
+        File::options().write(true).open(&manifest)?.sync_all()?;
+        return Ok(());
+    }
+    if ordinal != records.len() as u64 + 1 {
+        return Err(invalid("CAS prefix append has an ordinal gap"));
+    }
+    record.stored_bytes = Some(publish_blob(&blobs, &record, shared.as_bytes())?);
+    let mut serialized = serde_json::to_vec(&record)?;
+    serialized.push(b'\n');
+    let mut file = File::options().create(true).append(true).open(&manifest)?;
+    file.write_all(&serialized)?;
+    file.sync_all()?;
+    sync_directory(directory)
+}
+
+pub(crate) fn assert_prefix_complete(path: &Path) -> io::Result<()> {
+    let (head, _) = header(&mut File::open(path)?)?
+        .ok_or_else(|| invalid("CAS tail write requires its durable rollout header"))?;
+    let (_, manifest) = paths(path)?;
+    if read_records(&manifest)?.len() as u64 + 1 != head.prefix_end_ordinal {
+        return Err(invalid(
+            "CAS inherited prefix is incomplete; refusing local tail append",
+        ));
+    }
+    Ok(())
+}
+
+/// Opens one immutable logical snapshot. Physical-tail length is captured before its manifest,
+/// so a first child-tail append cannot be observed without its preceding inherited context.
+pub(crate) fn logical_snapshot(
+    path: &Path,
+    is_cancelled: impl Fn() -> bool,
+) -> io::Result<Option<File>> {
+    let mut source = File::open(path)?;
+    if header(&mut source)?.is_none() {
+        return Ok(None);
+    }
+    Ok(Some(open_logical_file(path, source, is_cancelled)?))
+}
+
+/// Retains the already-open ordinary representation across concurrent compression/rename.
+pub(crate) fn open_logical_file(
+    path: &Path,
+    mut source: File,
+    is_cancelled: impl Fn() -> bool,
+) -> io::Result<File> {
+    let source_len = source.metadata()?.len();
+    let Some((head, physical_header_end)) = header(&mut source)? else {
+        source.rewind()?;
+        return Ok(source);
+    };
+    let (blobs, manifest) = paths(path)?;
+    let records = read_records(&manifest)?;
+    if records.len() as u64 >= head.prefix_end_ordinal {
+        return Err(invalid("CAS prefix exceeds its frozen inherited boundary"));
+    }
+    if source_len > physical_header_end && records.len() as u64 + 1 != head.prefix_end_ordinal {
+        return Err(invalid(
+            "CAS local tail exists before the inherited prefix is complete",
+        ));
+    }
+    let mut logical = tempfile::tempfile()?;
+    logical.write_all(head.logical_session_meta.as_bytes())?;
+    for record in records {
+        if is_cancelled() {
+            return Err(io::Error::other("rollout read cancelled"));
+        }
+        let bytes = read_blob(&blobs, &record)?;
+        logical.write_all(record.literal.as_bytes())?;
+        logical.write_all(&bytes)?;
+    }
+    source.seek(SeekFrom::Start(physical_header_end))?;
+    let mut remaining = source.take(source_len.saturating_sub(physical_header_end));
+    let mut buffer = [0; 64 * 1024];
+    loop {
+        if is_cancelled() {
+            return Err(io::Error::other("rollout read cancelled"));
+        }
+        let count = remaining.read(&mut buffer)?;
+        if count == 0 {
+            break;
+        }
+        logical.write_all(&buffer[..count])?;
+    }
+    logical.rewind()?;
+    Ok(logical)
+}
+
+/// Strong revision including the inherited manifest. Corrupt required data fails closed.
+pub fn steward_cas_revision(path: &Path) -> io::Result<Option<String>> {
+    if !is_steward_cas_rollout(path)? {
+        return Ok(None);
+    }
+    let (blobs, manifest) = paths(path)?;
+    let records = read_records(&manifest)?;
+    let mut hash = Sha256::new();
+    hash.update(std::fs::read(path)?);
+    hash.update(std::fs::read(manifest)?);
+    for record in records {
+        read_blob(&blobs, &record)?;
+    }
+    Ok(Some(format!("steward-cas-v1:{:x}", hash.finalize())))
+}
+
+/// Writes a new standalone plain-history export. The required-CAS source is never replaced.
+pub fn export_steward_cas_rollout(path: &Path, destination: &Path) -> io::Result<String> {
+    if destination.exists() {
+        return Err(io::Error::new(
+            io::ErrorKind::AlreadyExists,
+            "export destination exists",
+        ));
+    }
+    let mut logical = logical_snapshot(path, || false)?
+        .ok_or_else(|| invalid("export source is not a CAS rollout"))?;
+    let directory = destination
+        .parent()
+        .ok_or_else(|| invalid("export destination has no parent"))?;
+    std::fs::create_dir_all(directory)?;
+    let mut temporary = tempfile::NamedTempFile::new_in(directory)?;
+    io::copy(&mut logical, &mut temporary)?;
+    temporary.as_file().sync_all()?;
+    logical.rewind()?;
+    let mut source_hash = Sha256::new();
+    let mut exported_hash = Sha256::new();
+    let mut exported = File::open(temporary.path())?;
+    let mut buffer = [0; 64 * 1024];
+    loop {
+        let read = logical.read(&mut buffer)?;
+        if read == 0 {
+            break;
+        }
+        source_hash.update(&buffer[..read]);
+    }
+    loop {
+        let read = exported.read(&mut buffer)?;
+        if read == 0 {
+            break;
+        }
+        exported_hash.update(&buffer[..read]);
+    }
+    let expected = source_hash.finalize();
+    if expected != exported_hash.finalize() {
+        return Err(invalid("plain history export failed byte verification"));
+    }
+    temporary
+        .persist_noclobber(destination)
+        .map_err(|error| error.error)?;
+    sync_directory(directory)?;
+    Ok(format!("{expected:x}"))
+}
+
+/// Exercises the actual native storage codec in an isolated temporary home.
+/// This is deliberately narrower than full agent spawn/resume acceptance.
+pub fn steward_storage_self_test() -> io::Result<serde_json::Value> {
+    let home = tempfile::tempdir()?;
+    let directory = home.path().join("sessions/2026/11/08");
+    std::fs::create_dir_all(&directory)?;
+    let metadata = "{\"timestamp\":\"2026-11-08T00:00:00.000Z\",\"ordinal\":0,\"type\":\"session_meta\",\"payload\":{\"history_mode\":\"paginated\"}}\n";
+    let payload =
+        "exact inherited content including user role and authorization ordering λ ".repeat(4096);
+    let mut original_bytes = 0;
+    let mut last = PathBuf::new();
+    for number in 0..2 {
+        let path = directory.join(format!("rollout-self-test-{number}.jsonl"));
+        std::fs::write(&path, wrap_session_meta(metadata, 2)?)?;
+        let inherited = format!(
+            "{{\"timestamp\":\"2026-11-08T00:00:00.00{number}Z\",\"ordinal\":1,\"type\":\"response_item\",\"payload\":{}}}\n",
+            serde_json::to_string(&payload)?
+        );
+        append_prefix(&path, 1, &inherited)?;
+        assert_prefix_complete(&path)?;
+        let expected = format!("{metadata}{inherited}");
+        let mut snapshot =
+            logical_snapshot(&path, || false)?.ok_or_else(|| invalid("missing test snapshot"))?;
+        let mut bytes = Vec::new();
+        snapshot.read_to_end(&mut bytes)?;
+        if bytes != expected.as_bytes() {
+            return Err(invalid("native storage self-test byte mismatch"));
+        }
+        original_bytes += expected.len();
+        last = path;
+    }
+    let (blobs, _) = paths(&last)?;
+    let shared_blob_bytes: u64 = std::fs::read_dir(blobs)?
+        .map(|entry| {
+            entry
+                .and_then(|entry| entry.metadata())
+                .map(|metadata| metadata.len())
+        })
+        .sum::<io::Result<_>>()?;
+    if shared_blob_bytes >= original_bytes as u64 * 3 / 4 {
+        return Err(invalid("native storage self-test found no sibling reuse"));
+    }
+    let export = home.path().join("export.jsonl");
+    export_steward_cas_rollout(&last, &export)?;
+    let mut logical = logical_snapshot(&last, || false)?.unwrap();
+    let mut expected = Vec::new();
+    logical.read_to_end(&mut expected)?;
+    if std::fs::read(export)? != expected {
+        return Err(invalid("native self-test export mismatch"));
+    }
+    Ok(serde_json::json!({
+        "capability": "steward-cas-child-prefix-v1",
+        "scope": "legacy_and_paginated_child_inherited_prefix",
+        "codec_self_test_passed": true,
+        "exact_bytes_verified": true,
+        "sibling_payload_reuse_verified": true,
+        "plain_export_verified": true,
+        "blob_codec": "zstd_level_3",
+        "logical_bytes_in_two_children": original_bytes,
+        "shared_blob_bytes": shared_blob_bytes,
+        "full_spawn_resume_verified": false,
+        "production_ready": false
+    }))
+}
