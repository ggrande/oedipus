+#[test]
+fn exact_bytes_and_shared_payloads_across_children() -> io::Result<()> {
+    let home = tempfile::tempdir()?;
+    let first = child(home.path(), "first", 3)?;
+    let second = child(home.path(), "second", 3)?;
+    let payload =
+        "transformed user context; authorization stays in stock order; λ\\n\"".repeat(4096);
+    let one = line(1, "2026-11-08T01:00:00.001Z", &payload);
+    let two = line(
+        2,
+        "2026-11-08T01:00:00.002Z",
+        "guardian context remains absent",
+    );
+    append_prefix(&first, 1, &one)?;
+    append_prefix(&first, 2, &two)?;
+    let other_one = line(1, "2026-11-08T02:00:00.001Z", &payload);
+    let other_two = line(
+        2,
+        "2026-11-08T02:00:00.002Z",
+        "guardian context remains absent",
+    );
+    append_prefix(&second, 1, &other_one)?;
+    append_prefix(&second, 2, &other_two)?;
+    let tail = line(3, "2026-11-08T03:00:00.001Z", "child only");
+    assert_prefix_complete(&first)?;
+    File::options()
+        .append(true)
+        .open(&first)?
+        .write_all(tail.as_bytes())?;
+    assert_eq!(
+        bytes(&first)?,
+        [meta(), &one, &two, &tail].concat().as_bytes()
+    );
+    assert_eq!(
+        bytes(&second)?,
+        [meta(), &other_one, &other_two].concat().as_bytes()
+    );
+    let (blobs, _) = paths(&first)?;
+    assert_eq!(std::fs::read_dir(&blobs)?.count(), 2);
+    let physical: u64 = std::fs::read_dir(blobs)?
+        .map(|entry| entry.unwrap().metadata().unwrap().len())
+        .sum();
+    assert!(physical < (one.len() + other_one.len()) as u64 * 3 / 4);
+    Ok(())
+}
